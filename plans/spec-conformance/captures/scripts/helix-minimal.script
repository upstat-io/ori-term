# helix-minimal.script
# Minimal helix edit session: opens /tmp/helix-capture.txt, types
# a line, saves, quits. Exercises helix's render loop + command
# palette without requiring a project or config.
COMMAND: hx /tmp/helix-capture.txt
WAIT: 1500ms
KEY: i
TEXT: hello helix world
KEY: Escape
WAIT: 200ms
KEY: :
TEXT: w
KEY: Enter
WAIT: 300ms
KEY: :
TEXT: q
KEY: Enter
