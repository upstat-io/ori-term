# htop-sort-search.script
# Open htop, cycle sort columns (F6), toggle tree view (F5),
# open the search box (F3), type a query, close search, quit (F10).
# Uses a scratch XDG_CONFIG_HOME via the runner to avoid picking
# up user htoprc settings.
COMMAND: htop
WAIT: 800ms
KEY: F6
WAIT: 200ms
KEY: Down
KEY: Down
KEY: Down
WAIT: 100ms
KEY: Enter
WAIT: 200ms
KEY: F5
WAIT: 200ms
KEY: F5
WAIT: 200ms
KEY: F3
WAIT: 200ms
TEXT: bash
WAIT: 200ms
KEY: Escape
WAIT: 200ms
KEY: F10
