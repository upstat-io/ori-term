# ncmpcpp-help.script
# Open ncmpcpp's help screen — doesn't require an MPD daemon,
# just renders the static key bindings list. Paints the main
# window + status bar + help text, giving us OSC title + SGR
# color + ACS box-drawing coverage.
COMMAND: ncmpcpp
WAIT: 1000ms
KEY: 1
WAIT: 300ms
KEY: Down
KEY: Down
KEY: Down
WAIT: 200ms
KEY: q
WAIT: 300ms
