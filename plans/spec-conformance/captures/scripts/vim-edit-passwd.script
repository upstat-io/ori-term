# vim-edit-passwd.script
# Edit /etc/passwd in vim: jump around, enter insert mode, type,
# save-as /tmp/passwd.copy, quit. `-u NONE` disables vimrc so the
# capture is deterministic across hosts.
COMMAND: vim -u NONE -c "set nocompatible ruler laststatus=2" /etc/passwd
WAIT: 500ms
KEY: G
WAIT: 100ms
KEY: g
KEY: g
WAIT: 100ms
KEY: Down
KEY: Down
KEY: Down
WAIT: 100ms
KEY: i
TEXT: hello world
KEY: Escape
WAIT: 100ms

KEY: :
TEXT: w! /tmp/passwd.copy
KEY: Enter
WAIT: 200ms
KEY: :
TEXT: q!
KEY: Enter
